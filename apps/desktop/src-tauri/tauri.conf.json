{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DSH desktop",
  "version": "0.1.0",
  "identifier": "io.github.coltcn.dsh-desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
